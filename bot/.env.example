# Токен бота от @BotFather
BOT_TOKEN=123456:ABCdef-your-token-here

# Публичный HTTPS-URL опубликованного Mini App (например, GitHub Pages).
# Telegram требует именно HTTPS — на http://localhost кнопка WebApp не откроется.
WEBAPP_URL=https://your-domain.example/

# Путь к файлу базы данных SQLite (можно оставить по умолчанию).
DB_PATH=users.db

# Канал обязательной подписки. Пока пусто — гейт выключен, приложение
# открывается всем. Укажи @username публичного канала, чтобы включить
# (также принимается ссылка t.me/<username> или числовой ID -100…).
# ВАЖНО: бот должен быть администратором этого канала, иначе проверка
# подписки не сработает (и доступ будет закрыт).
REQUIRED_CHANNEL=

# Ссылка на канал для кнопки «Подписаться». Для @username вычисляется
# автоматически. Заполни вручную для приватного канала или числового ID
# (например, https://t.me/+AbCdEf... для инвайт-ссылки).
CHANNEL_URL=
